{
  "title": "Folio · Edge & Infra (NGINX / Celery / Vault)",
  "uid": "folio-edge-infra",
  "tags": ["folio", "nginx", "celery", "vault"],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "NGINX — 활성 연결",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "nginx_connections_active", "refId": "A" }
      ]
    },
    {
      "id": 2,
      "title": "NGINX — 요청율 (req/s)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[5m])",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "NGINX — 연결 상태 분포",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 8 },
      "targets": [
        { "expr": "nginx_connections_reading", "legendFormat": "reading", "refId": "A" },
        { "expr": "nginx_connections_writing", "legendFormat": "writing", "refId": "B" },
        { "expr": "nginx_connections_waiting", "legendFormat": "waiting", "refId": "C" }
      ]
    },
    {
      "id": 4,
      "title": "Celery — Worker 상태",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        { "expr": "sum(celery_worker_up)", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Celery — 태스크 처리율 (5m)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (name) (rate(celery_task_succeeded_total[5m]))",
          "legendFormat": "{{name}} succeeded",
          "refId": "A"
        },
        {
          "expr": "sum by (name) (rate(celery_task_failed_total[5m]))",
          "legendFormat": "{{name}} failed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Celery — 큐 대기 길이",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 8, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "celery_queue_length",
          "legendFormat": "{{queue_name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Vault — Sealed 상태 (0=unsealed, 1=sealed)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "targets": [
        { "expr": "vault_core_unsealed", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "Sealed", "color": "red" }, "1": { "text": "Unsealed", "color": "green" } } }
          ]
        }
      }
    },
    {
      "id": 8,
      "title": "Vault — Transit Encrypt/Decrypt 요청율",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(vault_secret_kv_count[5m])",
          "legendFormat": "kv ops/s",
          "refId": "A"
        },
        {
          "expr": "rate(vault_audit_log_request_count[5m])",
          "legendFormat": "audit log req/s",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "title": "Vault — 응답시간 분위수",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 8 },
      "targets": [
        {
          "expr": "vault_core_handle_request{quantile=\"0.95\"}",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "vault_core_handle_request{quantile=\"0.99\"}",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" } }
    }
  ]
}
