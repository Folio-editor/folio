# ============================================================
# 운영용 환경변수 템플릿
#
# 사용법:
#   cp infra/.env.prod.example infra/prod/.env   # 후 모든 값 실제 값으로 교체
#
# ⚠️ 절대 git에 커밋하지 말 것. 시크릿 매니저 사용 권장.
# ============================================================

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
APP_VERSION=latest

# ----- Database -----
# 운영에서는 DB_HOST를 docker-compose 서비스명(postgresql)으로 자동 주입한다.
DB_NAME=storyzip
DB_USERNAME=storyzip
DB_PASSWORD=__REPLACE_ME__
DB_POOL_SIZE=20

# ----- Redis -----
REDIS_PASSWORD=__REPLACE_ME__

# ----- JWT (반드시 32자 이상의 강력한 랜덤 값으로 교체) -----
JWT_SECRET=__REPLACE_ME__

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=__REPLACE_ME__
GOOGLE_CLIENT_SECRET=__REPLACE_ME__

# ----- JVM -----
JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC
