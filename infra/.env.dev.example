# ============================================================
# 개발용 환경변수 템플릿
#
# 사용법:
#   cp infra/.env.dev.example infra/dev/.env
#
# IDE에서 backend를 직접 실행할 때는 동일 변수를 IDE 실행 설정의
# 환경변수에 등록하거나 backend/.env (devtools) 로 복사해 사용한다.
#
# ⚠️ .env 파일은 절대 git에 커밋하지 말 것.
# ============================================================

# ----- App -----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ----- Database -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storyzip
DB_USERNAME=storyzip
DB_PASSWORD=storyzip_dev

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT (개발용 더미. 운영에서는 반드시 교체) -----
JWT_SECRET=dev-secret-please-change-this-to-a-long-random-string-32chars

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
