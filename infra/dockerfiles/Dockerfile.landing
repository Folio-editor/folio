# ============================================================
# Folio Landing Page - 프로덕션 이미지
#
# 빌드 (프로젝트 루트에서 실행):
#   docker build -f infra/dockerfiles/Dockerfile.landing \
#     -t folio-landing:latest .
# ============================================================

# ---------- Build stage ----------
FROM node:22-alpine AS builder
WORKDIR /workspace

# VITE_* 빌드 시점 환경변수 — Vite가 import.meta.env.VITE_*로 노출
# .gitlab-ci.yml의 docker build --build-arg로 주입됨 (도플러 의존 없음)
ARG VITE_API_URL
ARG VITE_EDITOR_URL
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_EDITOR_URL=${VITE_EDITOR_URL}

RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

COPY landing/package.json landing/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY landing/ .
RUN pnpm build

# ---------- Runtime stage ----------
FROM nginx:1.30-alpine
WORKDIR /usr/share/nginx/html

RUN rm -rf /etc/nginx/conf.d/default.conf

# 랜딩 페이지용 nginx 설정 — access_log off: 메인 Nginx에서 트래픽 기록하므로 중복 제거
RUN printf 'server {\n\
    listen 80;\n\
    server_name _;\n\
    access_log off;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location /healthz {\n\
        return 200 "ok";\n\
        add_header Content-Type text/plain;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

COPY --from=builder /workspace/dist/ .

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
