# ============================================================
# Folio Web Editor - 프로덕션 이미지
#
# 멀티스테이지 빌드:
#   1) builder: pnpm build:web (Vite → dist-web/)
#   2) runtime: Nginx로 SPA 서빙
#
# 빌드 (프로젝트 루트에서 실행):
#   docker build -f infra/dockerfiles/Dockerfile.web \
#     --build-arg VITE_API_URL=https://folio.example.com/api \
#     --build-arg VITE_POWERSYNC_URL=https://folio.example.com/sync \
#     -t folio-web:latest .
#
# 실행:
#   docker run --rm -p 3000:80 folio-web:latest
# ============================================================

# ---------- Build stage ----------
FROM node:22-alpine AS builder
WORKDIR /workspace

# pnpm 활성화
RUN corepack enable && corepack prepare pnpm@10.33.0 --activate

# Vite 빌드 시점 환경변수 (ARG → ENV)
#
# ⚠️ VITE_ADMIN_API_TOKEN 은 의도적으로 ARG/ENV 에 추가하지 않는다.
# 일반 사용자 빌드(이 Dockerfile) 에 운영자 토큰이 박히면 dist-web/ JS 파일에
# 평문 노출됨. 운영자는 본인 PC 에서 pnpm dev / pnpm dev:web 로만 사용.
# build:web 스크립트가 산출물에 토큰 누출 시 빌드 자체를 실패시키므로
# 실수로 ARG 추가되더라도 이중 방어된다 (scripts/check-admin-token-leak.mjs).
ARG VITE_API_URL
ARG VITE_POWERSYNC_URL
ARG VITE_GOOGLE_CLIENT_ID
ARG VITE_GOOGLE_DESKTOP_CLIENT_ID
ARG VITE_LANDING_URL
ARG VITE_PORTONE_STORE_ID
ARG VITE_PORTONE_CHANNEL_KEY_ONETIME
ARG VITE_PORTONE_CHANNEL_KEY_BILLING
ENV VITE_API_URL=${VITE_API_URL} \
    VITE_POWERSYNC_URL=${VITE_POWERSYNC_URL} \
    VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID} \
    VITE_GOOGLE_DESKTOP_CLIENT_ID=${VITE_GOOGLE_DESKTOP_CLIENT_ID} \
    VITE_LANDING_URL=${VITE_LANDING_URL} \
    VITE_PORTONE_STORE_ID=${VITE_PORTONE_STORE_ID} \
    VITE_PORTONE_CHANNEL_KEY_ONETIME=${VITE_PORTONE_CHANNEL_KEY_ONETIME} \
    VITE_PORTONE_CHANNEL_KEY_BILLING=${VITE_PORTONE_CHANNEL_KEY_BILLING}

# 의존성 캐시: lockfile + .npmrc 먼저 복사
# .npmrc(node-linker=hoisted) 가 누락되면 pnpm이 isolated 모드로 install →
# transitive deps 미노출로 빌드 시점 unresolved import 발생 가능. 로컬 dev와 동일한
# 디렉토리 구조 보장 위해 반드시 함께 복사.
COPY frontend/package.json frontend/pnpm-lock.yaml frontend/.npmrc ./
RUN pnpm install --frozen-lockfile

# 소스 복사 후 웹 빌드
COPY frontend/ .
RUN pnpm build:web

# ---------- Runtime stage ----------
FROM nginx:1.30-alpine
WORKDIR /usr/share/nginx/html

# 기본 설정 제거 + SPA 설정 복사
RUN rm -rf /etc/nginx/conf.d/default.conf
COPY infra/dockerfiles/nginx-spa.conf /etc/nginx/conf.d/default.conf

# 빌드 결과물 복사
COPY --from=builder /workspace/dist-web/ .

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
