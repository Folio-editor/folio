# ============================================================
# IDE에서 backend를 직접 실행할 때 사용하는 환경변수
#
# 사용법:
#   cp backend/.env.example backend/.env
#   (값 수정 후 IntelliJ에서 ./gradlew bootRun 또는 main 클래스 실행)
#
# spring-dotenv 의존성이 시작 시 이 파일을 자동으로 환경변수로 주입한다.
# application*.yml 의 ${DB_HOST:localhost} 같은 placeholder 가 여기서 채워진다.
#
# Docker Compose 로 띄울 때는 이 파일이 아니라 infra/{env}/.env 를 사용한다.
#
# ⚠️ .env 파일은 절대 git에 커밋하지 말 것.
# ============================================================

# ----- App -----
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ----- Database (infra/dev/docker-compose.dev.yml 로 띄운 컨테이너 기준) -----
DB_HOST=localhost
DB_PORT=5432
DB_NAME=storyzip
DB_USERNAME=storyzip
DB_PASSWORD=storyzip_dev

# ----- Redis -----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----- JWT -----
JWT_SECRET=dev-secret-please-change-this-to-a-long-random-string-32chars

# ----- Google OAuth -----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ----- AI Server (FastAPI) -----
AI_SERVER_URL=http://localhost:8000
AI_INTERNAL_API_KEY=dev-internal-key

# ----- Google Analytics 4 -----
GA4_ENABLED=true
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_ENDPOINT=https://www.google-analytics.com/mp/collect
GA4_DEBUG_ENDPOINT=https://www.google-analytics.com/debug/mp/collect
GA4_DEBUG_MODE=false
