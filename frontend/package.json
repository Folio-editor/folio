{
  "name": "folio",
  "productName": "Folio",
  "version": "0.1.0",
  "description": "Folio - 스토리 작가를 위한 원고 편집 서비스",
  "main": "out/main/index.js",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "build:dir": "electron-vite build && electron-builder --dir",
    "build:win": "node scripts/check-direct-deps.mjs && electron-vite build && electron-builder --win nsis",
    "build:mac": "node scripts/check-direct-deps.mjs && electron-vite build && electron-builder --mac zip",
    "dev:web": "vite --config vite.web.config.ts",
    "build:web": "node scripts/check-direct-deps.mjs && vite build --config vite.web.config.ts",
    "check:deps": "node scripts/check-direct-deps.mjs",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": {
    "name": "추보문",
    "email": "cbm87961541@gmail.com"
  },
  "license": "MIT",
