# ============================================================
# Folio AI Server - Environment Variables
# ============================================================
# 실제 사용은 Doppler. 로컬 개발용 참고 파일.

# App
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO

# Spring ↔ FastAPI 공유 시크릿
INTERNAL_API_KEY=change-me-in-doppler

# DB (Day 3 이후)
DATABASE_URL=postgresql+asyncpg://storyzip:storyzip@localhost:5432/storyzip

# Redis / Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# LLM (Day 4 이후)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
CLAUDE_SONNET_MODEL=claude-sonnet-4-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# Provider 토글 (SSAFY GMS 키 발급 전: fake / 발급 후: openai, anthropic)
EMBEDDING_PROVIDER=fake
LLM_PROVIDER=fake
