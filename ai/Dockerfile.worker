# Docker run notes
# Run these from the project root after Docker Desktop starts:
# Start: docker compose -f infra/dev/docker-compose.dev.yml up -d
# Stop:  docker compose -f infra/dev/docker-compose.dev.yml down
#
# ============================================================
# Celery worker image
# ============================================================
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
RUN pip install --upgrade pip && pip install -e .

COPY app ./app

CMD ["celery", "-A", "app.celery_app", "worker", "-Q", "indexing,draft,review", "-c", "2", "-l", "info"]
